# ==============================================================================
# Conecta Nexus - Profile Microservice Environment Configuration
# ==============================================================================

# Database connection URL (PostgreSQL)
# Container network default: postgres:5432
# Local host default: localhost:5432
DATABASE_URL=postgresql://postgres:postgrespassword@postgres:5432/db_profiles

# Django Core Settings
DEBUG=True
SECRET_KEY=django-insecure-profile-dev-key-change-in-production
ALLOWED_HOSTS=*

# Server Host & Port
HOST=0.0.0.0
PORT=8000

# Cryptographic Public Key for RS256 JWT Verification (ADR-002)
JWT_PUBLIC_KEY_PATH=certs/jwt_public.pem
