# Django environment variables.
DJANGO_SECRET_KEY=replace-with-a-secure-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL environment variables.
POSTGRES_DB=db_profiles
POSTGRES_USER=profile_user
POSTGRES_PASSWORD=replace-with-a-secure-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60

# Optional Database URL (parsed automatically when provided)
DATABASE_URL=postgresql://profile_user:replace-with-a-secure-password@localhost:5432/db_profiles
